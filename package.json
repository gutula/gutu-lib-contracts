{
  "name": "gutu-lib-contracts",
  "private": true,
  "type": "module",
  "workspaces": [
    "framework/libraries/*"
  ],
  "scripts": {
    "build": "bun run --cwd framework/libraries/contracts build",
    "typecheck": "bun run --cwd framework/libraries/contracts typecheck",
    "lint": "bun run --cwd framework/libraries/contracts lint",
    "test": "bun run --cwd framework/libraries/contracts test",
    "test:contracts": "bun run --cwd framework/libraries/contracts test:contracts",
    "test:unit": "bun run --cwd framework/libraries/contracts test:unit",
    "docs:summary": "node scripts/docs-summary.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  }
}
